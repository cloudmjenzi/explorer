# ---- Required ----
SITE_DOMAIN=explorer.co.bw
APP_URL=https://explorer.co.bw
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# openssl rand -hex 32
CRON_SECRET=change-me

APP_NAME="Explorer Botswana"
COMPANY_LEGAL_NAME="Explorer Botswana (Pty) Ltd"
SUPPORT_EMAIL=hello@explorer.co.bw
SUPPORT_WHATSAPP=+26771000000
# Gets an email for new operators, listings to review, manual payments and refunds due
ADMIN_NOTIFY_EMAIL=ops@explorer.co.bw

# Default commission in basis points (1500 = 15%). Can be changed per operator in admin.
DEFAULT_COMMISSION_BPS=1500

# ---- Email (SMTP) ----  e.g. smtps://user:pass@smtp.zoho.com:465
SMTP_URL=
MAIL_FROM="Explorer Botswana <bookings@explorer.co.bw>"

# ---- Card payments ----
# dpo    = DPO Pay (works for Botswana-registered businesses, charges in BWP or USD)
# stripe = only with a company in a Stripe-supported country (e.g. AU); charges in USD
# none   = mobile money / EFT only
CARD_GATEWAY=dpo
CHARGE_CURRENCY=BWP

DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
# Leave the URLs as they are for live. DPO gives you sandbox URLs for testing.
DPO_API_URL=https://secure.3gdirectpay.com/API/v6/
DPO_PAY_URL=https://secure.3gdirectpay.com/payv2.php?ID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Manual payment methods ----  (leave blank to hide a method; \n = new line)
PAY_ORANGE_MONEY="Pay with Orange Money to merchant code 000000 (Explorer Botswana)"
PAY_MYZAKA=
PAY_SMEGA=
PAY_BANK_TRANSFER="FNB Botswana\nAccount: Explorer Botswana (Pty) Ltd\nAccount no: 0000000000\nBranch code: 000000"
HOLD_HOURS_MANUAL=24
HOLD_MINUTES_CARD=30

# Approximate display rates: units of currency per 1 BWP (update monthly)
DISPLAY_RATES={"USD":0.073,"EUR":0.067,"GBP":0.057,"ZAR":1.33}
